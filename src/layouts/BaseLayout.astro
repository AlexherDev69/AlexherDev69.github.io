---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import '../styles/base.css';
import '../styles/projects.css';
import '../styles/sections.css';
import '../styles/case-study.css';
import '../styles/lightbox.css';
import '../styles/responsive.css';
import { profile } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} · ${profile.role}`,
  description = `${profile.role} à Lyon. Applications web et mobiles de l'idée à la mise en ligne : 10 000 pas, EasyDiet, MirrorMind et d'autres projets.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = {
  url: new URL('/og-image.png', Astro.site),
  width: 1200,
  height: 630,
  alt: `${profile.name}, ${profile.role} à Lyon : captures de 10 000 pas et EasyDiet`,
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F5F2EC" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={shareImage.url} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage.url} />
    <meta name="twitter:image:alt" content={shareImage.alt} />

    <!-- Active les animations avant le premier rendu, sauf si le visiteur préfère les réduire -->
    <script is:inline>
      document.documentElement.classList.add(
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'static' : 'anim'
      );
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
