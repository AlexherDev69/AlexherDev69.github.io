---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.tsx';
import ProjectBrowser from '../components/ProjectBrowser.tsx';
import { portfolioProjects, profile } from '../data/portfolio';
---

<BaseLayout
  title={`Archive des dossiers · ${profile.name}`}
  description="Parcours des projets professionnels et personnels d'Alexandre Hernandez, un dossier à la fois."
>
  <div class="pv-topbar">
    <div class="container pv-topbar__inner">
      <a href="/" class="pv-back" aria-label="Retour au dossier">← Retour au dossier</a>
      <span class="pv-topbar__title">◵ MDR · Archive des dossiers</span>
      <ThemeToggle client:load />
    </div>
  </div>

  <main class="container pv-main">
    <ProjectBrowser projects={portfolioProjects} client:load />
    <p class="pv-hint">
      Naviguer entre les dossiers : flèches <kbd>←</kbd> <kbd>→</kbd> du clavier ou boutons latéraux.
    </p>
  </main>

  <style is:global>
    /* ---- Topbar ---- */
    .pv-topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      backdrop-filter: blur(10px);
      background: var(--head-bg);
      border-bottom: 1px solid var(--border);
    }
    .pv-topbar__inner {
      display: flex;
      align-items: center;
      gap: 1rem;
      height: 4rem;
    }
    .pv-back {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      transition: color 0.2s ease;
    }
    .pv-back:hover {
      color: var(--text-strong);
    }
    .pv-topbar__title {
      margin: 0 auto;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .pv-main {
      padding-block: clamp(1.5rem, 1.2rem + 2vw, 2.6rem) clamp(5rem, 4rem + 4vw, 7.5rem);
    }
    .pv-hint {
      text-align: center;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      margin-top: 2.5rem;
    }
    .pv-hint kbd {
      display: inline-block;
      padding: 0.1rem 0.45rem;
      border: 1px solid var(--border-strong);
      background: var(--surface);
      font-size: 0.85em;
      font-family: var(--font-mono);
    }

    /* ---- Navigateur ---- */
    .pv {
      max-width: 880px;
      margin-inline: auto;
    }

    /* Ligne de statut */
    .pv__status {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.6rem;
    }
    .pv__badge {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 0.35rem 0.7rem;
      color: var(--bg);
    }
    .pv__badge--pro {
      background: var(--accent);
    }
    .pv__badge--perso {
      background: var(--accent-2);
    }
    .pv__counter {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      letter-spacing: 0.14em;
      color: var(--muted);
    }
    .pv__dots {
      margin-left: auto;
      display: flex;
      gap: 7px;
      align-items: center;
    }
    .pv__dot {
      width: 9px;
      height: 9px;
      padding: 0;
      border: none;
      border-radius: 0;
      background: var(--border-strong);
      cursor: pointer;
      transition: width 0.25s ease, background-color 0.25s ease;
    }
    .pv__dot.is-active {
      width: 26px;
    }
    .pv__dot--pro.is-active {
      background: var(--accent);
    }
    .pv__dot--perso.is-active {
      background: var(--accent-2);
    }

    /* Carte dossier */
    .pv__card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: clamp(1.4rem, 1rem + 3vw, 2.6rem);
      animation: pv-slide-next 0.34s ease both;
    }
    .pv__card--prev {
      animation-name: pv-slide-prev;
    }
    @keyframes pv-slide-next {
      from { opacity: 0; transform: translateX(20px); }
      to { opacity: 1; transform: none; }
    }
    @keyframes pv-slide-prev {
      from { opacity: 0; transform: translateX(-20px); }
      to { opacity: 1; transform: none; }
    }

    .pv__eyebrow {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .pv__title {
      margin: 0.85rem 0 0;
      font-weight: 700;
      font-size: clamp(2.2rem, 5.2vw, 3.8rem);
      line-height: 1.03;
      letter-spacing: -0.02em;
      color: var(--text-strong);
    }
    .pv__tagline {
      margin-top: 1rem;
      max-width: 64ch;
      font-size: clamp(1rem, 2vw, 1.2rem);
      line-height: 1.65;
      color: var(--text);
    }
    .pv__highlight {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      margin-top: 1.25rem;
      padding: 0.55rem 0.9rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      color: var(--accent);
      border: 1px solid var(--accent);
    }

    /* Sections */
    .pv__section {
      margin-top: 2.5rem;
    }
    .pv__label {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.9rem;
    }
    .pv__label--accent {
      color: var(--accent);
    }
    .pv__body {
      margin-top: 0;
    }
    .pv__body .pv__section {
      margin-top: 2.1rem;
    }
    .pv__text {
      max-width: 72ch;
      font-size: 1rem;
      line-height: 1.8;
      color: var(--text);
    }
    .pv__list {
      margin: 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 0.7rem;
    }
    .pv__list li {
      position: relative;
      padding-left: 1.4rem;
      max-width: 72ch;
      font-size: 0.97rem;
      line-height: 1.7;
      color: var(--text);
    }
    .pv__bullet {
      position: absolute;
      left: 0;
      top: 0.15rem;
      font-family: var(--font-mono);
      color: var(--accent);
    }

    .pv__challenges {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
    }
    .pv__challenge {
      background: var(--surface);
      padding: 1.1rem 1.25rem;
    }
    .pv__challenge-head {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
    }
    .pv__challenge-no {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--accent);
    }
    .pv__challenge h3 {
      font-weight: 600;
      font-size: 1.05rem;
      line-height: 1.25;
      color: var(--text-strong);
    }
    .pv__challenge p {
      margin-top: 0.65rem;
      font-size: 0.86rem;
      line-height: 1.65;
      color: var(--muted);
    }

    .pv__result {
      margin-top: 2.1rem;
      border: 1px solid var(--accent);
      background: var(--accent-soft);
      padding: 1.4rem 1.5rem;
    }

    /* Pied : stack + liens */
    .pv__foot {
      margin-top: 2.5rem;
      padding-top: 1.6rem;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      gap: 1.4rem;
      flex-wrap: wrap;
      align-items: flex-start;
    }
    .pv__stack {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      list-style: none;
      padding: 0;
      margin: 0;
      max-width: 70%;
    }
    .pv__links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .pv__links a {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bg);
      background: var(--accent);
      padding: 0.55rem 0.8rem;
      transition: opacity 0.2s ease;
    }
    .pv__links a:hover {
      opacity: 0.85;
    }

    /* Galerie */
    .pv__shots {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }
    .pv__shot {
      position: relative;
      height: 300px;
      padding: 0;
      margin: 0;
      line-height: 0;
      overflow: hidden;
      border: 1px solid var(--border-strong);
      background: var(--terminal);
      cursor: zoom-in;
      transition: border-color 0.2s ease;
    }
    .pv__shot:hover {
      border-color: var(--accent);
    }
    .pv__shot img {
      height: 300px;
      width: auto;
      display: block;
      object-fit: cover;
    }
    .pv__shot-num {
      position: absolute;
      top: 8px;
      right: 8px;
      font-family: var(--font-mono);
      font-size: 0.58rem;
      letter-spacing: 0.1em;
      color: var(--accent);
      background: color-mix(in srgb, var(--terminal) 82%, transparent);
      padding: 3px 6px;
    }

    /* Flèches latérales fixes */
    .pv__arrow {
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      z-index: 15;
      display: grid;
      place-items: center;
      width: 3.5rem;
      height: 3.5rem;
      border-radius: 50%;
      backdrop-filter: blur(8px);
      background: var(--head-bg);
      border: 1px solid var(--border-strong);
      color: var(--text-strong);
      font-size: 1.25rem;
      cursor: pointer;
      transition: border-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
    }
    .pv__arrow:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .pv__arrow:active {
      transform: translateY(-50%) scale(0.95);
    }
    .pv__arrow--prev {
      left: clamp(0.5rem, 2vw, 1.6rem);
    }
    .pv__arrow--next {
      right: clamp(0.5rem, 2vw, 1.6rem);
    }
    @media (max-width: 560px) {
      .pv__arrow {
        width: 2.8rem;
        height: 2.8rem;
        font-size: 1.1rem;
      }
      .pv__arrow--prev { left: 0.4rem; }
      .pv__arrow--next { right: 0.4rem; }
      .pv__foot { flex-direction: column; }
      .pv__stack { max-width: 100%; }
    }

    /* Lightbox */
    .pv__lb {
      position: fixed;
      inset: 0;
      z-index: 40;
      background: rgba(3, 10, 12, 0.92);
      backdrop-filter: blur(6px);
      display: grid;
      place-items: center;
      padding: clamp(1rem, 4vw, 2.5rem);
      animation: pv-fade 0.2s ease both;
    }
    @keyframes pv-fade {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    .pv__lb-counter {
      position: absolute;
      top: 20px;
      left: 0;
      right: 0;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .pv__lb-fig {
      margin: 0;
      display: grid;
      place-items: center;
    }
    .pv__lb-fig img {
      max-width: 90vw;
      max-height: 78vh;
      object-fit: contain;
      border: 1px solid var(--border-strong);
    }
    .pv__lb-cap {
      position: absolute;
      bottom: 26px;
      left: 0;
      right: 0;
      text-align: center;
      max-width: 70ch;
      margin: 0 auto;
      padding: 0 20px;
      font-size: 0.82rem;
      color: var(--muted);
    }
    .pv__lb-arrow,
    .pv__lb-close {
      position: fixed;
      cursor: pointer;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: rgba(7, 20, 23, 0.7);
      border: 1px solid var(--border-strong);
      color: #eafcf6;
    }
    .pv__lb-arrow {
      top: 50%;
      transform: translateY(-50%);
      width: 3.25rem;
      height: 3.25rem;
      font-size: 1.25rem;
    }
    .pv__lb-arrow--prev { left: 18px; }
    .pv__lb-arrow--next { right: 18px; }
    .pv__lb-close {
      top: 16px;
      right: 18px;
      width: 2.6rem;
      height: 2.6rem;
      font-family: var(--font-mono);
      font-size: 0.9rem;
    }
    .pv__lb-arrow:hover,
    .pv__lb-close:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    @media (prefers-reduced-motion: reduce) {
      .pv__card,
      .pv__lb {
        animation: none;
      }
    }
  </style>
</BaseLayout>
