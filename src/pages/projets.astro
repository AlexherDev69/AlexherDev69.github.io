---
/**
 * Ancienne page d'archive des projets : les études de cas vivent désormais sur l'accueil.
 * Les liens /projets#slug existants ouvrent directement l'étude de cas correspondante.
 */
const home = new URL('/', Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>Projets · Alexandre Hernandez</title>
    <link rel="canonical" href={home} />
    <script is:inline>
      window.location.replace('/' + (window.location.hash || '#projets'));
    </script>
    <meta http-equiv="refresh" content="0; url=/#projets" />
  </head>
  <body>
    <a href="/#projets">Voir les projets</a>
  </body>
</html>
