---
import { skills } from '../data/portfolio';
---

<section id="skills" class="section section--ruled">
  <div class="container">
    <div class="reveal">
      <p class="section-index"><b>Section 02</b> · Aptitudes</p>
      <h2 class="section-title">Le manuel</h2>
    </div>

    <div class="manual">
      {skills.map((group, i) => (
        <article class="manual__entry reveal">
          <div class="manual__head">
            <span class="manual__no">2.{i + 1}</span>
            <h3 class="manual__title">{group.title}</h3>
          </div>
          <p class="manual__line">{group.items.join(' · ')}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .manual {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .manual__entry {
    background: var(--surface);
    padding: 1.4rem 1.5rem;
    transition: background-color 0.2s ease;
  }

  .manual__entry:hover {
    background: var(--surface-hover);
  }

  .manual__head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }

  .manual__no {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }

  .manual__title {
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    color: var(--text-strong);
  }

  .manual__line {
    margin-top: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 2;
    color: var(--muted);
  }
</style>
