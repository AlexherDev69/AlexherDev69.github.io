---
import { experiences, experienceSince } from '../data/portfolio';
---

<section id="parcours" class="sec" style="padding-top: 72px">
  <div class="wrap">
    <div class="sec__head">
      <h2 class="sec__title mask"><span>Parcours</span></h2>
      <span class="count rv">{experienceSince}</span>
    </div>
    <div class="xp">
      {experiences.map((item) => (
        <div class="xp__row rv">
          <span class="xp__when">{item.period}</span>
          <div class="xp__main">
            <h3 class="xp__role">{item.role}</h3>
            <p class="xp__org">{item.organization}</p>
          </div>
          <p class="xp__desc">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
