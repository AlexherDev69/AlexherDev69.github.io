---
import { experiences, education, languages } from '../data/portfolio';
---

<section id="experience" class="section section--ruled">
  <div class="container">
    <div class="reveal">
      <p class="section-index"><b>Section 03</b> · Historique</p>
      <h2 class="section-title">Registre de service</h2>
    </div>

    <div class="registry">
      {experiences.map((xp) => (
        <div class="registry__row reveal">
          <div class="registry__meta">
            <div class="registry__period">{xp.period}</div>
            <div class="registry__ctx">{xp.type} · {xp.location}</div>
          </div>
          <div>
            <h3 class="registry__role">{xp.role}</h3>
            <p class="registry__company">{xp.company}</p>
            <ul class="registry__list">
              {xp.highlights.map((h) => (
                <li><span class="registry__bullet" aria-hidden="true">›</span>{h}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}

      <div class="registry__row reveal">
        <div class="registry__meta">
          <div class="registry__ctx">Annexe</div>
        </div>
        <div class="registry__annex">
          <div>
            <p class="registry__annex-main">{education.degree}</p>
            <p class="registry__annex-sub">{education.school} · {education.year}</p>
          </div>
          <div>
            <p class="registry__annex-main">Langues</p>
            <p class="registry__annex-sub">{languages.join(' · ')}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .registry {
    margin-top: 2.2rem;
    display: grid;
    gap: 0;
  }

  .registry__row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: clamp(1.2rem, 4vw, 3.5rem);
    padding: 1.8rem 0;
    border-top: 1px solid var(--border);
  }

  .registry__period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .registry__ctx {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .registry__role {
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--text-strong);
  }

  .registry__company {
    margin: 0.3rem 0 1rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .registry__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .registry__list li {
    position: relative;
    padding-left: 1.3rem;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text);
  }

  .registry__bullet {
    position: absolute;
    left: 0;
    top: 0.1rem;
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .registry__annex {
    display: flex;
    gap: 3.5rem;
    flex-wrap: wrap;
  }

  .registry__annex-main {
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--text-strong);
  }

  .registry__annex-sub {
    margin-top: 0.2rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .registry__row {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
  }
</style>
