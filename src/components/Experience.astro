---
import Icon from './Icon.astro';
import { experiences, experienceSince } from '../data/portfolio';
import { projects } from '../data/projects';

const caseTitle = (slug: string): string => projects.find((project) => project.slug === slug)?.title ?? '';
---

<section id="parcours" class="sec" style="padding-top: 72px">
  <div class="wrap">
    <div class="sec__head">
      <h2 class="sec__title mask"><span>Parcours</span></h2>
      <span class="count rv">{experienceSince}</span>
    </div>
    <div class="xp">
      {experiences.map((item) => (
        <div class="xp__row rv">
          <span class="xp__when">{item.period}</span>
          <div class="xp__main">
            <h3 class="xp__role">{item.role}</h3>
            <p class="xp__org">{item.organization}</p>
          </div>
          <div class="xp__desc">
            <p>{item.description}</p>
            {item.missions && (
              <ul class="xp__list">
                {item.missions.map((mission) => (
                  <li>
                    {mission.text}
                    {mission.caseSlug && (
                      <button type="button" class="xp__case" data-open-case={mission.caseSlug} aria-label={`Voir l'étude de cas ${caseTitle(mission.caseSlug)}`}>
                        Étude de cas<Icon name="arrow-right" size={14} />
                      </button>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
