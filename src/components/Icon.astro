---
type IconName = 'arrow-right' | 'arrow-left' | 'arrow-down' | 'external' | 'close';

interface Props {
  name: IconName;
  size?: number;
}

const PATHS: Record<IconName, string> = {
  'arrow-right': 'M4 12h15M13 6l6 6-6 6',
  'arrow-left': 'M20 12H5M11 6l-6 6 6 6',
  'arrow-down': 'M12 4v15M6 13l6 6 6-6',
  external: 'M7 17L17 7M8 7h9v9',
  close: 'M6 6l12 12M18 6L6 18',
};

const DEFAULT_SIZE = 18;
const { name, size = DEFAULT_SIZE } = Astro.props;
---

<svg class="ico" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path d={PATHS[name]}></path></svg>
