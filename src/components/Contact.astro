---
import Icon from './Icon.astro';
import { profile, socials } from '../data/portfolio';

const year = new Date().getFullYear();
---

<section id="contact" class="contact">
  <div class="wrap">
    <span class="label rv">Contact</span>
    <h2 class="contact__title">
      <span class="mask"><span>{profile.contactTitle}</span></span>
      <span class="mask" style="--d: 120ms"><span><em>{profile.contactEmphasis}</em>&nbsp;?</span></span>
    </h2>
    <p class="contact__p rv" style="--d: 200ms">{profile.contactText}</p>
    <a class="mail rv" style="--d: 280ms" href={`mailto:${profile.email}`}>{profile.email}<Icon name="external" size={28} /></a>
    <div class="contact__links rv" style="--d: 340ms">
      {socials.map((social) => (
        <a href={social.url} target="_blank" rel="noopener noreferrer">{social.label}<Icon name="external" size={14} /></a>
      ))}
    </div>
    <footer class="foot">
      <span>© {year} {profile.name}</span>
      <span>{profile.location}</span>
      <a href="#top">Retour en haut</a>
    </footer>
  </div>
</section>
