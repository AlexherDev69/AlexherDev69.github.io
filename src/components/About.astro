---
import { profile, skills } from '../data/portfolio';
---

<section id="apropos" class="sec" style="padding-top: 72px">
  <div class="wrap about">
    <div class="about__pic rv">
      <img src={profile.portrait.src} alt={profile.portrait.alt} width={profile.portrait.width} height={profile.portrait.height} loading="lazy" decoding="async" />
    </div>
    <div class="about__body">
      <h2 class="label rv">À propos</h2>
      <p class="about__lead rv" style="--d: 80ms">{profile.aboutLead}</p>
      <p class="about__p rv" style="--d: 160ms">{profile.aboutText}</p>
      <div class="skills rv" style="--d: 240ms">
        {skills.map((group) => (
          <div class="skill">
            <h3>{group.title}</h3>
            <p>{group.items}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
