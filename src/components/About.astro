---
import { profile, stats } from '../data/portfolio';
---

<section id="about" class="section section--ruled">
  <div class="container">
    <div class="about reveal">
      <!-- Badge employé -->
      <div class="badge">
        <div class="badge__head">
          <span>◵ Badge</span>
          <span class="badge__clear">Niv. ∞</span>
        </div>
        <div class="badge__photo">
          <img
            src="/assets/moi/portrait.jpg"
            alt={profile.name}
            width="640"
            height="640"
            loading="lazy"
          />
        </div>
        <div class="badge__foot">
          <p class="badge__name">{profile.name}</p>
          <p class="badge__dept">Macrodata Refinement · Lyon</p>
          <div class="badge__barcode" aria-hidden="true"></div>
          <p class="badge__id">ID 0x1A · 2018—∞</p>
        </div>
      </div>

      <!-- Notice employé -->
      <div class="about__text">
        <p class="section-index"><b>Section 01</b> · L'employé</p>
        <h2 class="section-title">Six ans de raffinement, dix ans de compétition.</h2>
        {profile.bio.map((p) => <p class="about__p">{p}</p>)}

        <ul class="about__stats">
          {stats.map((s) => (
            <li class="about__stat">
              <span class="about__value">{s.value}</span>
              <span class="about__label">{s.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: clamp(1.8rem, 5vw, 4rem);
    align-items: start;
  }

  /* ---- Badge ---- */
  .badge {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.7);
  }

  .badge__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .badge__clear {
    color: var(--muted);
  }

  .badge__photo {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--terminal);
    filter: grayscale(0.35) contrast(1.05);
  }

  .badge__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge__foot {
    padding: 0.9rem;
  }

  .badge__name {
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.01em;
    color: var(--text-strong);
  }

  .badge__dept {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .badge__barcode {
    margin-top: 0.8rem;
    height: 34px;
    opacity: 0.85;
    background: repeating-linear-gradient(
      90deg,
      var(--text-strong) 0 2px,
      transparent 2px 4px,
      var(--text-strong) 4px 5px,
      transparent 5px 9px
    );
  }

  .badge__id {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: var(--muted);
  }

  /* ---- Notice ---- */
  .about__p {
    color: var(--text);
    margin-top: 1rem;
    max-width: 60ch;
    line-height: 1.8;
  }

  .about__p:last-of-type {
    color: var(--muted);
  }

  .about__stats {
    margin: 2.1rem 0 0;
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .about__stat {
    background: var(--surface);
    padding: 1.1rem 1rem;
  }

  .about__value {
    display: block;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--accent);
  }

  .about__label {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.6;
  }

  @media (max-width: 820px) {
    .about {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }
    .badge {
      max-width: 320px;
    }
  }

  @media (max-width: 460px) {
    .about__stats {
      grid-template-columns: 1fr;
    }
  }
</style>
