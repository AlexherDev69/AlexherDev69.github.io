---
import Icon from './Icon.astro';
import CaseStudy from './CaseStudy.astro';
import { projects } from '../data/projects';
---

<div class="detail" role="dialog" aria-modal="true" data-case-panel hidden>
  <div class="detail__bar">
    <div class="wrap detail__bar-in">
      <button type="button" class="back" data-case-close><Icon name="arrow-left" /><span>Tous les projets</span></button>
      <span class="label" data-case-position></span>
      <div class="pager">
        <button type="button" class="pager__btn" data-case-step="-1" aria-label="Projet précédent"><Icon name="arrow-left" /></button>
        <button type="button" class="pager__btn" data-case-step="1" aria-label="Projet suivant"><Icon name="arrow-right" /></button>
      </div>
    </div>
  </div>

  <div class="detail__body">
    {projects.map((project, index) => (
      <CaseStudy project={project} nextTitle={projects[(index + 1) % projects.length].title} />
    ))}
  </div>
</div>
