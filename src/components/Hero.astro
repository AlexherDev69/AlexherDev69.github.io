---
import { profile } from '../data/portfolio';

// Champ de chiffres « macro-données » généré au build (fond du terminal).
const rows = 16;
const cols = 44;
let macrodata = '';
for (let r = 0; r < rows; r++) {
  let line = '';
  for (let c = 0; c < cols; c++) {
    line += Math.floor(Math.random() * 10);
    if (Math.random() < 0.16) line += ' ';
  }
  macrodata += line + '\n';
}

// Bacs de raffinement (progression symbolique par pôle).
const bins = [
  { code: 'WEB', fill: '100%' },
  { code: 'APP', fill: '100%' },
  { code: 'API', fill: '92%' },
  { code: 'IA', fill: '86%' },
  { code: 'OPS', fill: '78%' },
];

const fileName = 'AlexandreH_2026.bin';
---

<section id="top" class="hero">
  <div class="container">
    <div class="terminal reveal">
      <div class="terminal__bar">
        <span class="terminal__tag terminal__tag--accent">◵ MDR — Poste 0x1A</span>
        <span class="terminal__tag">fichier : {fileName}</span>
        <span class="terminal__tag">raffiné : <b>100%</b></span>
      </div>

      <div class="terminal__screen">
        <pre class="terminal__nums" aria-hidden="true">{macrodata}</pre>
        <div class="terminal__vignette" aria-hidden="true"></div>
        <div class="terminal__center">
          <p class="terminal__eyebrow">Dossier employé — accès autorisé</p>
          <h1 class="terminal__name">{profile.name}</h1>
          <p class="terminal__role">
            {profile.role}<span class="terminal__cursor" aria-hidden="true">▊</span>
          </p>
        </div>
      </div>

      <div class="terminal__bins">
        {bins.map((b) => (
          <div class="bin">
            <span class="bin__code">{b.code}</span>
            <span class="bin__track"><i style={`width:${b.fill}`}></i></span>
          </div>
        ))}
      </div>
    </div>

    <div class="hero__under reveal">
      <p class="hero__lead">{profile.tagline} Chaque dossier est raffiné avec soin.</p>
      <div class="hero__actions">
        <a href="#projects" class="btn btn-primary">Ouvrir les dossiers</a>
        <a href="#contact" class="btn btn-ghost">Contact</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.2rem, 2rem + 3vw, 4rem) clamp(2rem, 1.5rem + 3vw, 3rem);
  }

  /* ---- Terminal MDR ---- */
  .terminal {
    position: relative;
    border: 1px solid var(--border-strong);
    background: var(--terminal);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--border), 0 40px 90px -40px rgba(0, 0, 0, 0.7),
      inset 0 0 120px rgba(0, 0, 0, 0.5);
  }

  .terminal__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    padding: 0.75rem 1.1rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .terminal__tag b {
    color: var(--accent);
    font-weight: 500;
  }

  .terminal__tag--accent {
    color: var(--accent);
  }

  .terminal__screen {
    position: relative;
    min-height: clamp(320px, 46vh, 460px);
    display: grid;
    place-items: center;
    padding: 2.6rem 1.2rem;
  }

  .terminal__nums {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 2.1;
    letter-spacing: 0.35em;
    color: var(--accent);
    white-space: pre-wrap;
    word-break: break-all;
    overflow: hidden;
    opacity: 0.14;
    animation: nums-breathe 6s ease-in-out infinite;
    -webkit-mask-image: radial-gradient(
      circle at 50% 42%,
      transparent 24%,
      black 68%
    );
    mask-image: radial-gradient(circle at 50% 42%, transparent 24%, black 68%);
  }

  @keyframes nums-breathe {
    0%, 100% { opacity: 0.1; }
    50% { opacity: 0.18; }
  }

  .terminal__vignette {
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 140px 30px rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }

  .terminal__center {
    position: relative;
    text-align: center;
  }

  .terminal__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .terminal__name {
    margin-top: 1.1rem;
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: 0.01em;
    font-size: var(--step-4);
    color: var(--text-strong);
    text-shadow: 0 0 26px var(--halo);
  }

  .terminal__role {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1.7vw, 0.95rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text);
  }

  .terminal__cursor {
    color: var(--accent);
    animation: cursor-blink 1.05s steps(1) infinite;
  }

  @keyframes cursor-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .terminal__bins {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    background: var(--border);
    border-top: 1px solid var(--border);
  }

  .bin {
    background: var(--bg-soft);
    padding: 0.75rem 0.6rem;
    text-align: center;
  }

  .bin__code {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .bin__track {
    display: block;
    margin: 0.5rem auto 0;
    height: 5px;
    width: 82%;
    background: var(--border);
  }

  .bin__track i {
    display: block;
    height: 100%;
    background: var(--accent);
  }

  /* ---- Sous le terminal ---- */
  .hero__under {
    margin-top: 1.4rem;
    display: flex;
    justify-content: space-between;
    gap: 1.4rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero__lead {
    margin: 0;
    max-width: 52ch;
    font-size: 0.97rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .hero__actions {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  @media (max-width: 560px) {
    .terminal__bins {
      grid-template-columns: repeat(5, 1fr);
    }
    .bin__code {
      font-size: 0.55rem;
    }
  }
</style>
