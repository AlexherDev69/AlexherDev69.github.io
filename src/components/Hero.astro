---
import Icon from './Icon.astro';
import { profile } from '../data/portfolio';

const [firstLine, secondLine, lastLineStart] = profile.heroTitle;
---

<section id="top" class="hero">
  <div class="wrap">
    <div class="hero__meta">
      <span class="label">{profile.role}, Lyon</span>
      <span class="label">{profile.availability}</span>
    </div>
    <div class="rule"></div>
    <h1 class="hero__title">
      <span class="line"><span style="--i: 0">{firstLine}</span></span>{' '}
      <span class="line"><span style="--i: 1">{secondLine}</span></span>{' '}
      <span class="line"><span style="--i: 2">{lastLineStart} <em>{profile.heroEmphasis}</em>.</span></span>
    </h1>
    <div class="hero__foot">
      <p class="hero__lead">{profile.heroLead}</p>
      <a class="hero__cue" href="#projets">
        <span>Voir les projets</span>
        <span class="cue__ring"><Icon name="arrow-down" /></span>
      </a>
    </div>
  </div>
</section>
