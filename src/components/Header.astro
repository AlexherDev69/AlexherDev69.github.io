---
import ThemeToggle from './ThemeToggle.tsx';
import { profile } from '../data/portfolio';

const links = [
  { href: '#about', label: 'Employé' },
  { href: '#skills', label: 'Aptitudes' },
  { href: '#experience', label: 'Historique' },
  { href: '#projects', label: 'Dossiers' },
  { href: '#contact', label: 'Contact' },
];

// Wordmark : nom de famille en capitales espacées.
const wordmark = profile.name.split(' ').slice(-1)[0].toUpperCase();
---

<header class="header">
  <div class="container header__inner">
    <a href="#top" class="brand" aria-label="Accueil">
      <span class="brand__ring" aria-hidden="true"></span>
      <span class="brand__name">{wordmark}</span>
      <span class="brand__tag">Macrodata Refinement</span>
    </a>

    <nav class="nav" id="nav" aria-label="Navigation principale">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="header__actions">
      <ThemeToggle client:load />
      <button
        type="button"
        class="menu-btn"
        id="menu-btn"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="nav"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('menu-btn');
    const nav = document.getElementById('nav');
    if (!btn || !nav) return;
    const close = () => {
      nav.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
    };
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
    });
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
  })();
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(10px);
    background: var(--head-bg);
    border-bottom: 1px solid var(--border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  /* Anneau MDR (référence Lumon, sans le logo ni le nom) */
  .brand__ring {
    position: relative;
    width: 26px;
    height: 26px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    flex: none;
  }

  .brand__ring::after {
    content: '';
    position: absolute;
    inset: 5px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    border-right-color: transparent;
    border-bottom-color: transparent;
  }

  .brand__name {
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .brand__tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    border-left: 1px solid var(--border);
    padding-left: 0.8rem;
  }

  .nav {
    margin-left: auto;
    display: flex;
    gap: 1.4rem;
  }

  .nav a {
    font-family: var(--font-mono);
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .nav a:hover {
    color: var(--text-strong);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.3rem;
    height: 2.1rem;
    border-radius: 0;
    border: 1px solid var(--border-strong);
    background: transparent;
    cursor: pointer;
  }

  .menu-btn span {
    display: block;
    width: 18px;
    height: 2px;
    margin-inline: auto;
    background: var(--text);
  }

  @media (max-width: 820px) {
    .brand__tag {
      display: none;
    }
    .nav {
      position: absolute;
      top: 4rem;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--bg-soft);
      border-bottom: 1px solid var(--border);
      padding: 0.4rem 0;
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .nav.is-open {
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }
    .nav a {
      padding: 0.9rem clamp(1rem, 4vw, 2.5rem);
      font-size: 0.8rem;
    }
    .menu-btn {
      display: flex;
    }
  }
</style>
