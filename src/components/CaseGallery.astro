---
import type { GalleryFrame, Project } from '../data/projects';

interface Props {
  project: Project;
}

const FRAME_CLASS: Record<GalleryFrame, string> = {
  phone: 'g phone',
  tile: 'g tile',
  wide: 'g g--wide',
  short: 'g g--short',
};

const { project } = Astro.props;
const { gallery } = project;
const imageIndexOffset = gallery.video ? 1 : 0;
---

<div class="wrap">
  <div class="d-band" style={`background: ${project.tint}`}>
    <div class="d-gallery" data-autoscroll data-drag-scroll>
      {gallery.video && (
        <div class="g tile" style="--i: 0" role="button" tabindex="0" aria-label="Voir la vidéo en plein écran" data-lightbox-item>
          <video muted loop playsinline preload="none" poster={gallery.video.poster} width={gallery.video.width} height={gallery.video.height} aria-label={gallery.video.label} data-autoplay>
            <source src={gallery.video.src} type="video/mp4" />
          </video>
        </div>
      )}

      {gallery.images.map((image, index) => (
        <div class={FRAME_CLASS[gallery.frame]} style={`--i: ${index + imageIndexOffset}`} role="button" tabindex="0" aria-label={`Agrandir : ${image.alt}`} data-lightbox-item>
          <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>
</div>
